<?xml version="1.0" ?>
<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CinemaTogether.Desktop.App" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#111114"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#1B1B22"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#F2664E"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EDEBF2"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2B2A32"/>
      <Setter Property="Foreground" Value="#F1EEF4"/>
      <Setter Property="Padding" Value="15,10"/>
      <Setter Property="Margin" Value="0,0,10,10"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#22222A"/>
      <Setter Property="Foreground" Value="#F1EEF4"/>
      <Setter Property="BorderBrush" Value="#383640"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,5,0,16"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#22222A"/>
      <Setter Property="Foreground" Value="#F1EEF4"/>
      <Setter Property="BorderBrush" Value="#383640"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,5,0,16"/>
      <Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#19191F"/>
      <Setter Property="Foreground" Value="#E7E3ED"/>
      <Setter Property="RowBackground" Value="#1C1C23"/>
      <Setter Property="AlternatingRowBackground" Value="#212129"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="RowHeight" Value="42"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Single"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#292831"/>
      <Setter Property="Foreground" Value="#AEA6B8"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#918B9D"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,24"/>
    </Style>
  </Application.Resources>
</Application>
