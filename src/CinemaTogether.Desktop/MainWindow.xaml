<?xml version="1.0" ?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" x:Class="CinemaTogether.Desktop.MainWindow" Title="twoWatch — Cinema Together" Width="1280" Height="840" MinWidth="960" MinHeight="650" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="205"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border BorderBrush="#292831" BorderThickness="0,0,1,0" Padding="20,30">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top">
          <TextBlock FontSize="27" FontWeight="Bold" Margin="5,0,0,45">
            <Run Text="two"/>
            <Run Text="Watch" Foreground="#F2664E"/>
          </TextBlock>
          <TextBlock Text="ВАШ КИНОЗАЛ" Foreground="#74707F" FontSize="10" Margin="8,0,0,18"/>
          <Button Content="▣   Главная" Tag="Home" Click="Navigate_Click" HorizontalContentAlignment="Left"/>
          <Button Content="▦   Медиатека" Tag="Library" Click="Navigate_Click"/>
          <Button Content="▶   Комната просмотра" Tag="Room" Click="Navigate_Click"/>
          <Button Content="♙   Участники" Tag="People" Click="Navigate_Click"/>
          <Button Content="⚙   Настройки" Tag="Settings" Click="Navigate_Click"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Bottom">
          <TextBlock Text="◈ Только свои" Foreground="#C39D92" Margin="6,0,0,8"/>
          <TextBlock Text="Видео остаются
на вашем компьютере" Foreground="#77717F" FontSize="11" Margin="6,0,0,20"/>
          <TextBlock x:Name="SidebarStatus" Text="● Сервер остановлен" Foreground="#918B9D" FontSize="11"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="38"/>
      </Grid.RowDefinitions>
      <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" Padding="36,30">
        <StackPanel>
          <TextBlock Text="Хороший вечер начинается с кино" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Выберите фильм, запустите комнату и пригласите друзей." Style="{StaticResource Caption}"/>
          <Border Background="#1C1B22" CornerRadius="12" Padding="26" Margin="0,10,0,24">
            <StackPanel>
              <TextBlock Text="ВАША КОМНАТА" Foreground="#F2664E" FontSize="10"/>
              <TextBlock x:Name="HomeRoomName" FontSize="25" Margin="0,8,0,20"/>
              <WrapPanel>
                <Button x:Name="StartButton" Content="▶  Запустить сервер" Background="#F2664E" Click="Start_Click"/>
                <Button x:Name="StopButton" Content="■  Остановить" IsEnabled="False" Click="Stop_Click"/>
                <Button Content="Открыть кинозал" Click="OpenRoom_Click"/>
                <Button Content="Скопировать ссылку" Click="CopyLink_Click"/>
              </WrapPanel>
              <TextBox x:Name="ConnectionLinks" Text="Ссылка появится после запуска сервера" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#A8A1B2" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
          </Border>
          <UniformGrid Columns="3" Margin="0,0,0,24">
            <Border Background="#1B1B22" CornerRadius="10" Padding="22" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="МЕДИАТЕКА" FontSize="10" Foreground="#918B9D"/>
                <TextBlock x:Name="MediaCount" Text="0" FontSize="32" Margin="0,10,0,0"/>
                <TextBlock Text="видео для совместного вечера" FontSize="10" Foreground="#918B9D"/>
              </StackPanel>
            </Border>
            <Border Background="#1B1B22" CornerRadius="10" Padding="22" Margin="0,0,14,0">
              <StackPanel>
                <TextBlock Text="В КОМНАТЕ" FontSize="10" Foreground="#918B9D"/>
                <TextBlock x:Name="PeopleCount" Text="0" FontSize="32" Margin="0,10,0,0"/>
                <TextBlock Text="участников на связи" FontSize="10" Foreground="#918B9D"/>
              </StackPanel>
            </Border>
            <Border Background="#1B1B22" CornerRadius="10" Padding="22">
              <StackPanel>
                <TextBlock Text="ОТПРАВЛЕНО ВИДЕО" FontSize="10" Foreground="#918B9D"/>
                <TextBlock x:Name="Traffic" Text="0 МБ" FontSize="30" Margin="0,10,0,0"/>
                <TextBlock x:Name="TrafficRate" Text="0 Мбит/с" FontSize="10" Foreground="#918B9D"/>
              </StackPanel>
            </Border>
          </UniformGrid>
          <TextBlock Text="Как устроить просмотр" FontSize="20" Margin="0,0,0,18"/>
          <TextBlock Text="01   В настройках задайте пароль комнаты (не менее 6 символов).
02   Добавьте видео в медиатеку и запустите сервер.
03   Выберите фильм, откройте кинозал и отправьте ссылку друзьям." Foreground="#A69DAC"/>
          <Border Background="#211D20" CornerRadius="8" Padding="18" Margin="0,28,0,0">
            <TextBlock Text="Для просмотра через интернет удобно использовать Tailscale или ZeroTier. Публичный IP требует настройки переадресации порта на роутере. При обычном HTTP пароль и видео передаются без шифрования — используйте доверенную сеть VPN или настройте HTTPS." Foreground="#BD9E94" FontSize="12"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="LibraryPanel" Visibility="Collapsed" Margin="36,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Ваша медиатека" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Оригиналы остаются на диске. FFprobe определит формат и дорожки." Style="{StaticResource Caption}"/>
        </StackPanel>
        <WrapPanel Grid.Row="1">
          <Button Content="＋ Добавить видео" Click="AddFiles_Click"/>
          <Button Content="＋ Добавить папку" Click="AddFolder_Click"/>
          <Button Content="Смотреть выбранное" Background="#F2664E" Click="SelectMedia_Click"/>
          <Button Content="В очередь" Click="QueueMedia_Click"/>
          <Button Content="Убрать из медиатеки" Click="RemoveMedia_Click"/>
        </WrapPanel>
        <DataGrid x:Name="LibraryGrid" Grid.Row="2">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="*"/>
            <DataGridTextColumn Header="Кодек" Binding="{Binding VideoCodec}" Width="90"/>
            <DataGridTextColumn Header="Высота" Binding="{Binding Height}" Width="75"/>
            <DataGridCheckBoxColumn Header="Напрямую" Binding="{Binding DirectPlay}" Width="85"/>
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="ImportStatus" Grid.Row="3" Foreground="#A69DAC" Margin="0,16,0,0"/>
      </Grid>
      <Grid x:Name="RoomPanel" Visibility="Collapsed">
        <wv:WebView2 x:Name="Browser"/>
        <TextBlock x:Name="BrowserHint" Text="Запустите сервер и откройте кинозал" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A69DAC" FontSize="18"/>
      </Grid>
      <Grid x:Name="PeoplePanel" Visibility="Collapsed" Margin="36,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Участники" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Вы управляете доступом и правами. Отключённый участник должен войти заново." Style="{StaticResource Caption}"/>
        </StackPanel>
        <DataGrid x:Name="PeopleGrid" Grid.Row="1">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*"/>
            <DataGridCheckBoxColumn Header="Организатор" Binding="{Binding IsHost}" Width="110"/>
            <DataGridCheckBoxColumn Header="Управление" Binding="{Binding CanControl}" Width="110"/>
            <DataGridCheckBoxColumn Header="Буферизация" Binding="{Binding Buffering}" Width="110"/>
          </DataGrid.Columns>
        </DataGrid>
        <WrapPanel Grid.Row="2" Margin="0,20,0,0">
          <Button Content="Разрешить управление" Tag="allow" Click="Grant_Click"/>
          <Button Content="Забрать управление" Tag="deny" Click="Grant_Click"/>
          <Button Content="Отключить" Click="Kick_Click"/>
        </WrapPanel>
      </Grid>
      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="36,30">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left" Width="630">
          <TextBlock Text="Настройки" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Изменения применяются при следующем запуске сервера." Style="{StaticResource Caption}"/>
          <TextBlock Text="Название комнаты"/>
          <TextBox x:Name="RoomNameInput" MaxLength="80"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="IP для прослушивания (0.0.0.0 — все интерфейсы)"/>
              <TextBox x:Name="AddressInput"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
              <TextBlock Text="Порт"/>
              <TextBox x:Name="PortInput"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="Новый пароль комнаты (пусто — сохранить текущий)"/>
          <PasswordBox x:Name="PasswordInput" MaxLength="128"/>
          <TextBlock Text="Путь к FFmpeg (или ffmpeg, если доступен через PATH)"/>
          <TextBox x:Name="FfmpegInput"/>
          <TextBlock Text="Путь к FFprobe"/>
          <TextBox x:Name="FfprobeInput"/>
          <TextBlock Text="Видеокодировщик: libx264, h264_nvenc, h264_qsv, h264_amf"/>
          <TextBox x:Name="EncoderInput"/>
          <TextBlock Text="PFX-сертификат HTTPS (пусто — HTTP)"/>
          <TextBox x:Name="CertificateInput"/>
          <TextBlock Text="Пароль PFX (не сохраняется на диск)"/>
          <PasswordBox x:Name="CertificatePasswordInput"/>
          <WrapPanel>
            <Button Content="Сохранить настройки" Background="#F2664E" Click="SaveSettings_Click"/>
            <Button Content="Диагностика" Click="Diagnostics_Click"/>
            <Button Content="Открыть журнал" Click="OpenLogs_Click"/>
          </WrapPanel>
          <TextBlock x:Name="DiagnosticsText" Foreground="#AEA3B3" Margin="0,15,0,20"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" Background="#19191E" BorderBrush="#292831" BorderThickness="0,1,0,0" Padding="24,8">
        <TextBlock x:Name="StatusText" Text="Готово к хорошему вечеру" FontSize="11" Foreground="#918B9D"/>
      </Border>
    </Grid>
  </Grid>
</Window>
